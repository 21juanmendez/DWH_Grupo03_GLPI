              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement that generates the lookup table."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT UsuarioKey, UsuarioId_origen, Login, NombreCompleto, Perfil, Telefono, Ubicacion, Titulo, Categoria, Activo
FROM DimUsuario
WHERE EsVigente = 'Si' AND UsuarioKey &gt; 0</property>
