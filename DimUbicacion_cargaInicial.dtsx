        <SQLTask:SqlTaskData
          SQLTask:Connection="{31D28ED9-DB65-40E8-9BC1-08E073A88D3B}"
          SQLTask:SqlStatementSource="DELETE FROM DimUbicacion;&#xA;DBCC CHECKIDENT('DimUbicacion', RESEED, 0);&#xA;&#xA;SET IDENTITY_INSERT DimUbicacion ON;&#xA;INSERT INTO DimUbicacion (UbicacionKey, UbicacionId_origen, Ubicacion, UbicacionCompleta,&#xA;Edificio, Sala, Ciudad, Estado, Pais)&#xA;VALUES (-1, -1, 'Sin ubicacion', 'Sin ubicacion', 'N/A', 'N/A', 'N/A', 'N/A', 'N/A');&#xA;SET IDENTITY_INSERT DimUbicacion OFF;&#xA;DBCC CHECKIDENT('DimUbicacion', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
