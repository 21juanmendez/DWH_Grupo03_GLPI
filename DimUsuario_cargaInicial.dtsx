            <component
              refId="Package\Llenar DimUsuario\Leer base de datos GLPI"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Consume datos de SQL Server, OLE DB, ODBC u Oracle mediante el correspondiente proveedor de datos de .NET Framework. Se usa una instrucción Transact-SQL para definir el conjunto de resultados. Por ejemplo, se extraen datos de SQL Server con el proveedor de datos de .NET Framework para SQL Server.;Microsoft Corporation; Microsoft SQL Server; © Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;4"
              description="Consume datos de SQL Server, OLE DB, ODBC u Oracle mediante el correspondiente proveedor de datos de .NET Framework. Se usa una instrucción Transact-SQL para definir el conjunto de resultados. Por ejemplo, se extraen datos de SQL Server con el proveedor de datos de .NET Framework para SQL Server."
              name="Leer base de datos GLPI"
              usesDispositions="true"
              version="4">
              <properties>
                <property
                  dataType="System.String"
                  description="Especifica la instrucción SQL utilizada por el componente para extraer datos."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    u.id                                                            AS UsuarioId_origen,
    COALESCE(NULLIF(TRIM(u.name),''),'Desconocido')                 AS Login,
    COALESCE(NULLIF(TRIM(CONCAT_WS(' ', u.firstname, u.realname)),''),
             NULLIF(TRIM(u.name),''),'Desconocido')                 AS NombreCompleto,
    COALESCE((SELECT p.name
              FROM glpi_profiles_users pu
                       JOIN glpi_profiles p ON p.id = pu.profiles_id
              WHERE pu.users_id = u.id
              ORDER BY pu.is_default_profile DESC, p.id ASC
              LIMIT 1),'Sin perfil')                               AS Perfil,
    COALESCE(NULLIF(TRIM(u.phone),''),
             NULLIF(TRIM(u.mobile),''),'No disponible')             AS Telefono,
    CAST(COALESCE(NULLIF(TRIM(l.completename),''),'Sin ubicacion') AS CHAR(255)) AS Ubicacion,
    COALESCE(NULLIF(TRIM(ut.name),''),'Sin titulo')                 AS Titulo,
    COALESCE(NULLIF(TRIM(uc.name),''),'Sin categoria')              AS Categoria,
    CASE WHEN u.is_active = 1 THEN 'Si' ELSE 'No' END               AS Activo,
    CURRENT_DATE                                                    AS FechaInicio,
    DATE('9999-12-31')                                              AS FechaFin,
    'Si'                                                            AS EsVigente
FROM glpi_users u
         LEFT JOIN glpi_locations      l  ON l.id  = u.locations_id
         LEFT JOIN glpi_usertitles     ut ON ut.id = u.usertitles_id
         LEFT JOIN glpi_usercategories uc ON uc.id = u.usercategories_id
ORDER BY u.id;


SELECT
    e.id                                                            AS EntidadId_origen,
    COALESCE(NULLIF(TRIM(e.name),''),'Sin nombre')                  AS Entidad,
    COALESCE(NULLIF(TRIM(e.completename),''),
             NULLIF(TRIM(e.name),''),'Sin nombre')                  AS EntidadCompleta,
    COALESCE(e.level,1)                                             AS Nivel,
    COALESCE(NULLIF(TRIM(e.town),''),'No especificado')             AS Ciudad,
    COALESCE(NULLIF(TRIM(e.state),''),'No especificado')            AS Estado,
    COALESCE(NULLIF(TRIM(e.country),''),'No especificado')          AS Pais
FROM glpi_entities e
ORDER BY e.id;


SELECT
    l.id                                                            AS UbicacionId_origen,
    COALESCE(NULLIF(TRIM(l.name),''),'Sin nombre')                  AS Ubicacion,
    COALESCE(NULLIF(TRIM(l.completename),''),
             NULLIF(TRIM(l.name),''),'Sin nombre')                  AS UbicacionCompleta,
    COALESCE(NULLIF(TRIM(l.building),''),'N/A')                     AS Edificio,
    COALESCE(NULLIF(TRIM(l.room),''),'N/A')                         AS Sala,
    COALESCE(NULLIF(TRIM(l.town),''),'No especificado')             AS Ciudad,
    COALESCE(NULLIF(TRIM(l.state),''),'No especificado')            AS Estado,
    COALESCE(NULLIF(TRIM(l.country),''),'No especificado')          AS Pais
FROM glpi_locations l
ORDER BY l.id;



SELECT
    c.id                                                            AS CategoriaId_origen,
    COALESCE(NULLIF(TRIM(c.name),''),'Sin nombre')                  AS Categoria,
    COALESCE(NULLIF(TRIM(c.completename),''),
             NULLIF(TRIM(c.name),''),'Sin nombre')                  AS CategoriaCompleta,
    COALESCE(c.level,1)                                             AS Nivel,
    COALESCE(NULLIF(TRIM(c.code),''),'N/A')                         AS Codigo
FROM glpi_itilcategories c
ORDER BY c.id;


SELECT
    g.id                                                            AS GrupoId_origen,
    COALESCE(NULLIF(TRIM(g.name),''),'Sin nombre')                  AS Grupo,
    COALESCE(NULLIF(TRIM(g.completename),''),
             NULLIF(TRIM(g.name),''),'Sin nombre')                  AS GrupoCompleto,
    COALESCE(g.level,1)                                             AS Nivel,
    COALESCE(NULLIF(TRIM(pg.name),''),'Ninguno')                    AS GrupoPadre,
    CASE WHEN g.is_assign = 1 THEN 'Si' ELSE 'No' END               AS EsAsignable
FROM glpi_groups g
         LEFT JOIN glpi_groups pg ON pg.id = g.groups_id
ORDER BY g.id;</property>
